# Copy to api/.env for local development. Never commit real secrets.
#
# PostgreSQL and Redis run in Docker: `npm run db:up`. They publish 5433 and
# 6380 rather than the defaults, so they cannot collide with a PostgreSQL or
# Redis already installed on the machine.

NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://fundfusion:fundfusion_dev_only@localhost:5433/fundfusion_dev
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Mock OTP is printed to API logs in development only.
OTP_STATIC_DEV=246810

# Displayed product name. Defaults to FundFusion when unset or empty.
# PLATFORM_NAME=FundFusion
# VITE_PLATFORM_NAME=FundFusion

# Integration and schema tests run against a real PostgreSQL (PRD §13.4).
TEST_DATABASE_URL=postgresql://fundfusion:fundfusion_dev_only@localhost:5433/fundfusion_test

# Google OAuth (PRD §9.1). Sign-in reports itself unconfigured until both are
# set; nothing else depends on them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# BSC testnet, from one NodeReal MegaNode key (docs/DEPENDENCIES.md §2.1).
# The deposit watcher subscribes over WSS and reads at the finalized head;
# the public testnet RPC drops requests, and a watcher that misses a block
# loses a deposit silently (PRD §8.2).
# BSC_RPC_HTTP_URL=
# BSC_RPC_WS_URL=
# The BEP-20 that stands in for USDT on testnet, deployed by this project —
# there is no official Tether there (docs/DEPENDENCIES.md §2.4).
# USDT_CONTRACT_ADDRESS=

# Custody (PRD §8.1). The HD master seed lives here or in the host's secret
# manager — never in the database, never in a settings table, never on an
# admin screen. A key an admin can read is a key that leaks with an admin
# account. Testnet-only values during v1.
# BSC_HD_SEED=
# BSC_GAS_WALLET_KEY=
